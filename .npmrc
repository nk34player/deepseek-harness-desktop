# The desktop shell builds a universal macOS installer (one fat binary with
# x64 + arm64 slices) entirely on arm64 CI runners. Per-arch optional deps
# such as koffi (@koromix/koffi-darwin-*) and node-pty prebuilds must be
# installed for BOTH CPUs so the deployed harness closure carries both
# variants. The staged Node runtime and harness closure then include both
# darwin-x64 and darwin-arm64, and the shell picks the matching one at launch
# (apps/desktop/src/env.ts reads runtime/<platform>-<arch> from process.arch).
supportedArchitectures:
  cpu:
    - x64
    - arm64
